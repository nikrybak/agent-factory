{
  "$comment": [
    "Registry of secret-bearing locations (ADR-0028). Read by the PreToolUse guard (.claude/hooks/secret_rules.js and its",
    "Python reference secret_rules.py) and by the safe accessor scripts/secret.js. Patterns only, never a machine path:",
    "'$VAR/rest' resolves an environment variable at run time, '~/rest' the user's home, anything else is a glob",
    "('**/' any folders, '*' any characters except '/', a glob without '/' matches the file name; a leading '*' needs at",
    "least one character and never matches a dot file). Matching is case-insensitive and treats '\\' as '/'.",
    "To add a location: append a glob (or a path) to an existing store or add a store; list in 'consumers' only programs",
    "that use the file WITHOUT printing it. 'standalone': true marks globs that also look like code (x.key, ctx.env):",
    "inside a shell command they match only a whole argument or a word with a '/'. Run the hook tests afterwards."
  ],
  "version": 1,
  "stores": [
    {"id": "gradle-user-home", "paths": ["$GRADLE_USER_HOME/gradle.properties", "~/.gradle/gradle.properties"],
     "globs": ["**/.gradle/gradle.properties", "**/gradle/gradle.properties"], "consumers": ["gradle", "gradlew"]},
    {"id": "secret-overlay", "globs": ["**/.secrets/**"], "consumers": []},
    {"id": "keystore", "globs": ["*.jks", "*.keystore", "*.bks", "*.p12", "*.pfx", "*.keychain", "*.keychain-db"],
     "consumers": ["keytool", "jarsigner", "apksigner", "bundletool", "gradle", "gradlew"]},
    {"id": "private-key", "globs": ["*.pem", "*.ppk", "*.keytab", "id_rsa", "id_dsa", "id_ecdsa", "id_ed25519",
     "**/.ssh/id_*", "**/.android/adbkey", "*.kdbx"], "consumers": ["ssh", "ssh-add", "scp", "sftp", "adb"]},
    {"id": "private-key", "globs": ["*.key"], "standalone": true, "consumers": ["ssh", "ssh-add", "scp", "sftp"]},
    {"id": "env-file", "globs": [".env", ".env.*", ".envrc", ".dev.vars"], "consumers": []},
    {"id": "env-file", "globs": ["*.env"], "standalone": true, "consumers": []},
    {"id": "signing-properties", "globs": ["keystore.properties", "signing.properties", "key.properties",
     "secrets.properties", "local.properties"], "consumers": ["gradle", "gradlew"]},
    {"id": "service-account", "globs": ["*-sa.json", "*service-account*.json", "*service_account*.json",
     "client_secret*.json", "credentials.json", "application_default_credentials.json", "agconnect-services.json"],
     "consumers": ["gradle", "gradlew"]},
    {"id": "credential-file", "globs": [".git-credentials", ".netrc", "_netrc", ".yarnrc.yml", ".pypirc",
     ".htpasswd", "**/.aws/credentials", "**/.docker/config.json", "**/.kube/config", "**/.cargo/credentials",
     "**/.cargo/credentials.toml", "*.tfvars", "*.tfstate"], "consumers": []},
    {"id": "npm-config", "globs": [".npmrc"], "consumers": ["npm", "npx", "pnpm", "yarn"]},
    {"id": "gh-config", "paths": ["$GH_CONFIG_DIR/hosts.yml", "~/.config/gh/hosts.yml"],
     "globs": ["**/gh/hosts.yml", "**/github cli/hosts.yml"], "consumers": []},
    {"id": "wrangler-config", "globs": ["**/.wrangler/config/*.toml"], "consumers": ["wrangler"]}
  ],
  "dirs": [
    {"id": "gradle-user-home", "paths": ["$GRADLE_USER_HOME", "~/.gradle"], "consumers": ["gradle", "gradlew"]},
    {"id": "gh-config", "paths": ["$GH_CONFIG_DIR", "~/.config/gh"], "consumers": ["gh"]},
    {"id": "wrangler-config", "paths": ["~/.wrangler", "~/.config/.wrangler"], "consumers": ["wrangler"]},
    {"id": "credential-dir", "paths": ["~/.ssh", "~/.aws", "~/.docker", "~/.gnupg"], "consumers": ["ssh", "gpg"]},
    {"id": "secret-overlay", "globs": ["**/.secrets"], "consumers": []}
  ],
  "allow": ["*.example", "*.sample", "*.template", "*.dist", "*.pub", "*.example.*"],
  "safePrograms": [
    "ls", "dir", "stat", "test", "[", "[[", "file", "wc", "du", "realpath", "readlink", "basename", "dirname",
    "cd", "pushd", "popd", "chdir", "set-location", "sl", "push-location", "pop-location", "test-path", "resolve-path",
    "split-path", "join-path", "get-item", "gi", "get-childitem", "gci", "mkdir", "md", "touch", "echo",
    "write-host", "write-output", "export", "setx", "git check-ignore", "git ls-files", "git status"
  ],
  "ignoreWords": ["process.env", "import.meta.env", "meta.env", "this.env", "self.env", "ctx.env", "c.env",
    "context.env", "req.env", "request.env", "env.env"],
  "secretEnvNames": {
    "substrings": ["TOKEN", "SECRET", "PASSWORD", "PASSWD", "PASSPHRASE", "CREDENTIAL", "PRIVATE", "APIKEY", "ACCESSKEY"],
    "parts": ["KEY", "PASS", "PAT", "PWD"],
    "notSecret": ["PWD", "OLDPWD", "TOKENIZERS_PARALLELISM", "SSH_AUTH_SOCK", "GPG_TTY", "PASSWORD_STORE_DIR",
      "KEY_ALIAS"]
  },
  "publicKeys": ["org.gradle.*", "android.*", "kotlin.*", "sdk.dir", "ndk.dir", "cmake.dir", "*.storeFile",
    "*.keyAlias", "*Url", "*.actor"],
  "aliases": {"gradle": ["$GRADLE_USER_HOME/gradle.properties", "~/.gradle/gradle.properties"]}
}
