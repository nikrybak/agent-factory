{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schema/toolchain-trust.schema.json",
  "title": "Factory local toolchain trust overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "platformFamily", "entries"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "platformFamily": { "enum": ["win32", "posix"] },
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["logicalExecutable", "sha256"],
        "properties": {
          "logicalExecutable": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._+-]{0,63}$",
            "not": { "enum": ["node", "npm", "npx"] }
          },
          "sha256": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    }
  }
}
