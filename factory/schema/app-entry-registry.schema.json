{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:software-factory:app-entry-registry:1.0.0",
  "title": "City Fabric child application registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projects"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "invariant": {
      "type": "string",
      "minLength": 1
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9][a-z0-9._-]{0,61}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!\\\\)(?!.*(?:^|[\\\\/])\\.?(?:[\\\\/]|$))(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "versionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/version"
        },
        "path": {
          "$ref": "#/$defs/relativePath",
          "description": "Optional restatement of the derived directory <key>-<id>; any other value is rejected."
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "versions"
      ],
      "properties": {
        "active": {
          "$ref": "#/$defs/version"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/versionEntry"
          }
        },
        "back": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "repo": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "runtime": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "enum": [
                "disabled",
                "advisory",
                "governed"
              ]
            },
            "capabilityPacks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "providerClasses": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "presentLocally": {
          "type": "boolean"
        },
        "app": {
          "$ref": "#/$defs/app"
        },
        "stack": {
          "type": "object"
        },
        "ci": {
          "type": "object"
        },
        "demo": {
          "type": "object"
        },
        "neighbours": {
          "type": "array"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilityPacks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime": {
          "$ref": "#/$defs/runtime"
        },
        "market": {
          "$ref": "#/$defs/market"
        }
      }
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stores",
        "locales"
      ],
      "properties": {
        "stores": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "locales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locale"
          }
        },
        "extraLocales": {
          "description": "Locales only one store lists, keyed by a declared store, in addition to the shared locales; no entry repeats a shared locale.",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/locale"
            }
          }
        }
      }
    }
  }
}
