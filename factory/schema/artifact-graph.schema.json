{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:software-factory:artifact-graph:1.0.0",
  "title": "Software factory artifact traceability graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nodes", "edges"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "1.0.0" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "path"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["intent", "requirement", "spec", "adr", "module", "test", "evidence", "release"] },
        "path": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "type"],
      "properties": {
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "type": { "enum": ["defines", "specified-by", "governed-by", "implemented-by", "constrains", "verified-by", "produces", "qualifies", "depends-on"] }
      }
    }
  }
}
