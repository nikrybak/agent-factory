{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/factory/trust-policy.schema.json",
  "title": "Factory trust policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultDecision", "allowedRoots", "tiers"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "defaultDecision": { "const": "deny" },
    "allowedRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "algorithm", "trustedKeys"],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "algorithm": { "const": "Ed25519" },
        "trustedKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keyId", "publicKeySpkiBase64", "fingerprintSha256"],
            "properties": {
              "keyId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "publicKeySpkiBase64": { "type": "string", "minLength": 1 },
              "fingerprintSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "tiers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executables", "authorities", "network", "maximumRisk"],
        "properties": {
          "executables": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "authorities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "network": {
            "type": "object", "additionalProperties": false, "required": ["mode", "hosts"],
            "properties": { "mode": { "enum": ["none", "allowlist"] }, "hosts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
          },
          "maximumRisk": { "enum": ["low", "medium", "high", "critical"] }
        }
      }
    }
  }
}
