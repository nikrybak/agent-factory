{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.local/schema/evidence-provider.schema.json",
  "title": "Software factory evidence-provider catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "providers"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "enum": ["1.0.0", "1.1.0"] },
    "providers": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": "1.0.0" } }, "required": ["schemaVersion"] },
      "then": { "properties": { "providers": { "items": { "$ref": "#/$defs/providerV10" } } } }
    },
    {
      "if": { "properties": { "schemaVersion": { "const": "1.1.0" } }, "required": ["schemaVersion"] },
      "then": { "properties": { "providers": { "items": { "$ref": "#/$defs/providerV11" } } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "operationName": { "enum": ["test", "coverage", "e2e", "security"] },
    "providerV10": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["builtin", "composite"] },
        "operation": { "$ref": "#/$defs/id" },
        "operations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/operationName" }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "builtin" } }, "required": ["kind"] }, "then": { "required": ["operation"], "not": { "required": ["operations"] } } },
        { "if": { "properties": { "kind": { "const": "composite" } }, "required": ["kind"] }, "then": { "required": ["operations"], "not": { "required": ["operation"] } } }
      ]
    },
    "providerV11": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["builtin", "composite"] },
        "operation": { "$ref": "#/$defs/id" },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/operationTarget" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "builtin" } }, "required": ["kind"] }, "then": { "required": ["operation"], "not": { "required": ["operations"] } } },
        { "if": { "properties": { "kind": { "const": "composite" } }, "required": ["kind"] }, "then": { "required": ["operations"], "not": { "required": ["operation"] } } }
      ]
    },
    "operationTarget": {
      "type": "object", "additionalProperties": false, "required": ["name", "selector"],
      "properties": {
        "name": { "$ref": "#/$defs/operationName" },
        "selector": {
          "type": "object", "additionalProperties": false, "required": ["componentIds"],
          "properties": {
            "componentIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        },
        "notApplicable": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["componentId", "reasonCode", "reason"],
            "properties": {
              "componentId": { "$ref": "#/$defs/id" },
              "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    }
  }
}
